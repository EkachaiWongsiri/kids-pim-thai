{
  "$schema": "https://www.mxiaapp.com/schemas/game-manifest-v1.schema.json",
  "schemaVersion": 1,
  "id": "kids-pim-thai",
  "version": "1.0.0",
  "status": "production",
  "title": { "th": "คิดส์พิมพ์ไทย", "en": "Kids Pim Thai" },
  "description": {
    "th": "เกมฝึกทักษะการพิมพ์สัมผัสภาษาไทยและภาษาอังกฤษสำหรับเด็ก",
    "en": "A Thai and English touch-typing game for children"
  },
  "route": "/app/kids-pim-thai",
  "legacyRoutes": ["/th/app/kids-pim-thai"],
  "entry": "index.html",
  "build": { "type": "vite", "command": "npm run build", "outputDir": "dist" },
  "storage": {
    "driver": "localStorage",
    "namespace": "mxia:game:kids-pim-thai:v1:",
    "schemaVersion": 1,
    "softLimitBytes": 150000,
    "keys": ["settings", "scores", "custom_words", "total_words", "word_sets"],
    "legacyKeys": [
      "kids_pim_thai_settings_v1",
      "kids_pim_thai_scores_v1",
      "kids_pim_thai_custom_words_v1",
      "kids_pim_thai_total_words_v1"
    ]
  },
  "capabilities": ["touch", "keyboard", "audio", "speech-synthesis", "fullscreen"],
  "externalOrigins": [],
  "browserTest": {
    "readySelector": "#root",
    "startSelector": "button",
    "startedSelector": "canvas"
  },
  "performance": {
    "recommendedInitialTransferBytes": 2000000,
    "maximumInitialTransferBytesWithoutApproval": 5000000
  }
}
